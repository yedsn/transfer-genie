    #[cfg(target_os = "windows")]
    {
        use winreg::enums::*;
        use winreg::RegKey;

        let hkcu = RegKey::predef(HKEY_CURRENT_USER);
        let run = hkcu
            .open_subkey_with_flags(
                "Software\\Microsoft\\Windows\\CurrentVersion\\Run",
                KEY_WRITE,
            )
            .map_err(|err| format!("operation failed: {err}"))?;

        if enabled {
            run.set_value("transfer-genie", &exe_str.to_string())
                .map_err(|err| format!("operation failed: {err}"))?;
        } else {
            let _ = run.delete_value("transfer-genie");
        }
    }

    #[cfg(target_os = "macos")]
    {
        use std::process::Command;

        .map_err(|_| "operation failed".to_string())?;
        let plist_path = format!("{}/Library/LaunchAgents/com.transfer-genie.plist", home);

