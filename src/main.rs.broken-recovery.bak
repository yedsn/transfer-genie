偘绮欏濠氭晬閸曨亝鍕冮梺浼欑到閻濡烽敂杞扮盎閻熸粌鐬煎▎銏狀潩鐠洪缚鎽曞┑鐐村灟閸ㄥ湱绮绘繝姘€甸梻鍫熺⊕閸熺偤鏌涢敐鍕祮闁诡喗顨堥幉鎾礋椤掆偓椤︹晠姊洪幖鐐插闁绘牕銈搁幃浼搭敋閳ь剟鐛崶顒夋晣闁绘柨鍢叉俊鎶芥⒒娓氣偓濞佳呮崲閹烘挻鍙忛悗娑櫭閬嶅箹濞ｎ剙濡介柍閿嬪笒闇夐柨婵嗘噺閸熺偤鏌涢悢鍝勪户缂佽鲸甯″畷顐﹀礋椤掆偓娴犳挳鎮楃憴鍕婵炲弶鐗犻幃楣冩倻閽樺鍊為悷婊勭矊铻炴繝濠傜墛閳锋垿鏌ら幁鎺戝壄妞ゅ繐鐓婚崶顒夋晣闁靛繒濮烽崝锕€顪冮妶鍡楃瑐缂佲偓娴ｈ櫣绠旈柟鐑樻尪娴滄粍銇勯幇鍓佹偧缂佺姷鍋為妵鍕閳藉棙鐣烽梺鐟板槻閹虫劙骞夐幘顔肩妞ゆ劗鍠庢禍楣冩煟閹达絽袚闁抽攱甯掗湁闁挎繂鎳忛崯鐐烘煙椤栨氨澧涢柕鍥у楠炲鈹戦崶鑸碉骏缂傚倷绶￠崰妤呮偡閳哄懐宓侀悗锝庡枟閺呮粓鏌涜箛鎿冩Ц濞存粓绠栭弻銊╁即閻愭祴鍋撹ぐ鎺戝惞闁告洦鍏欐禍婊堟煛瀹ュ洦鏆╃紒瀣嚙铻栭柡鍐ㄥ€荤壕浠嬫煕鐏炴崘澹橀柍褜鍓熼ˉ鎾斥枎閵忋倖鏅搁柣妯垮皺閻涖儱鈹戞幊閸婃洟骞婅箛娑樼；闁跨喓濮甸悡鍐煕濠靛棗顏柛锝嗘そ閺? {err}"))?
        } else {
            let legacy = serde_json::from_value::<LegacySettings>(value)
                .map_err(|err| format!("operation failed: {err}"))?;
            let mut endpoints = Vec::new();
            let mut active_id = None;
            let url = legacy.webdav_url.trim().to_string();
            if !url.is_empty() {
                let id = generate_endpoint_id();
                endpoints.push(WebDavEndpoint {
                    id: id.clone(),
                    name: String::new(),
                    url,
                    username: legacy.username.trim().to_string(),
                    password: legacy.password,
                    enabled: true,
                });
                active_id = Some(id);
            }
            let sender_name = if legacy.sender_name.trim().is_empty() {
                random_sender_name()
            } else {
                legacy.sender_name
            };
            Settings {
                webdav_endpoints: endpoints,
                active_webdav_id: active_id,
                sender_name,
                refresh_interval_secs: legacy.refresh_interval_secs,
                download_dir: legacy.download_dir,
                global_hotkey_enabled: true,
                global_hotkey: DEFAULT_GLOBAL_HOTKEY.to_string(),
                send_hotkey: DEFAULT_SEND_HOTKEY.to_string(),
                auto_start: false,
                auto_update_enabled: false,
                local_http_api: LocalHttpApiSettings::default(),
                telegram: TelegramBridgeSettings::default(),
                backup: BackupSettings::default(),
            }
        };
        let normalized = normalize_settings(settings, fallback_download_dir)?;
        write_settings(path, &normalized)?;
        Ok(normalized)
    } else {
        let settings = Settings {
            webdav_endpoints: Vec::new(),
            active_webdav_id: None,
            sender_name: random_sender_name(),
            refresh_interval_secs: 5,
            download_dir: normalize_download_dir("", fallback_download_dir),
            global_hotkey_enabled: true,
            global_hotkey: DEFAULT_GLOBAL_HOTKEY.to_string(),
            send_hotkey: DEFAULT_SEND_HOTKEY.to_string(),
            auto_start: false,
            auto_update_enabled: false,
            local_http_api: LocalHttpApiSettings::default(),
            telegram: TelegramBridgeSettings::default(),
            backup: BackupSettings::default(),
        };
        write_settings(path, &settings)?;
        Ok(settings)
    }
}

fn write_settings(path: &Path, settings: &Settings) -> Result<(), String> {
    let audit_root = path.parent().map(|parent| parent.join("workspace"));
    workspace::write_json_with_audit_at(
        path,
        settings,
        audit_root.as_deref(),
        "settings",
        "write-settings",
    )
}

fn updater_runtime_config(app: &AppHandle) -> Result<UpdaterPluginRuntimeConfig, String> {
    let value = app
        .config()
        .plugins
        .0
        .get("updater")
        .cloned()
        .ok_or_else(|| "operation failed".to_string())?;
