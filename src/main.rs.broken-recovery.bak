}

fn reject_legacy_local_http_marked_option_fields(value: &serde_json::Value) -> Result<(), String> {
    let Some(object) = value.as_object() else {
        return Ok(());
    };
    for legacy_field in ["selectedTagIds", "createdTags", "deletedTagIds"] {
