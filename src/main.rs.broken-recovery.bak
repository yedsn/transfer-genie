    // 闂傚倸鍊搁崐鎼佸磹閹间礁纾归柟闂寸绾惧綊鏌熼梻瀵割槮缁炬儳缍婇弻鐔兼⒒鐎靛壊妲紒鐐劤缂嶅﹪寮婚悢鍏尖拻閻庨潧澹婂Σ顔剧磼閻愵剙鍔ゆ繝鈧柆宥呯劦妞ゆ帒鍊归崵鈧柣搴㈠嚬閸欏啫鐣峰畷鍥ь棜閻庯絻鍔嬪Ч妤呮⒑閸︻厼鍔嬮柛銊ョ秺瀹曟劙鎮欓悜妯轰画濠电姴锕ら崯鎵不閼姐倐鍋撳▓鍨灍濠电偛锕顐﹀礃椤旇偐锛滃┑鐐村灦閼归箖鐛崼鐔剁箚闁绘劦浜滈埀顑惧€濆畷銏＄鐎ｎ亜鐎梺鍓茬厛閸嬪棝銆呴崣澶岀瘈闂傚牊渚楅崕鎰版煟閹惧瓨绀冪紒缁樼洴瀹曞崬螖閸愵亶鍞虹紓鍌欒兌婵灚绻涙繝鍥ц摕鐎广儱鐗滃銊╂⒑閸涘﹥灏扮紒璇茬墦閺佹劙鎮欓弶鎴犵獮婵犵數鍋炵敮妤€顪冮挊澶樺殨濞寸姴顑傞埀顒佺墵閸╁嫰宕橀埞澶歌檸闂備浇妗ㄧ粈渚€宕弶鎴犳殾闁圭儤顨呭洿闂佺硶鍓濊摫闁绘繃鐗楃换婵嬫偨闂堟稐绮跺銈嗘处閸樹粙骞堥妸鈺佺妞ゆ洖鎳忛弲鐐烘⒑缁洖澧茬紒瀣浮瀹曟垿宕掗悙闈涘絼闂佹悶鍎崝搴ㄥ煀閺囥垺鐓熼柟鎯х摠缁€鍐煏閸パ冾伃妤犵偛娲畷婊勬媴閻熼杩樼紓鍌氬€烽懗鑸垫叏閻㈠憡鍋嬮柡鍥ｆ噰閳ь剨濡囬幑鍕Ω閿曗偓绾绢垶姊洪崨濠勭畵閻庢岸鏀辩粋鎺撱偅閸愨斁鎷洪梻鍌氱墛缁嬫帡骞栭幇鐗堝€垫慨姗嗗亜瀹撳棝鏌曢崱鏇犵獢鐎殿喗鎸虫慨鈧柍鈺佸暞閻濇娊姊绘担铏广€婇柛鎾寸箞閹兘顢涘В纭风秬閵囨劙骞掗幘顖涘濠电偠鎻徊浠嬪箟閿熺姴绠氶柛顐犲劜閻撶喐銇勯幘璺哄壉婵″弶妞介弻鐔肩嵁閸喚浠奸梺瀹狀潐閸ㄥ灝鐣烽崡鐐╂瀻闁归偊鍙庨崯搴ㄦ⒒閸屾瑧顦﹀鐟帮躬瀹曟垿宕ㄩ鍏兼そ瀵€燁槼闁哄棙绮撳濠氬磼濞嗘垹鐛㈠┑鐐板尃閸ャ劍娅栭棅顐㈡处缁嬫垹澹曢崗鑲╃瘈濠电姴鍊搁鐢电磼閹插绡€婵﹤顭峰畷鎺戭潩椤戣棄浜鹃柟闂寸绾惧綊鏌ｉ幋锝呅撻柛銈呭閺屾盯顢曢敐鍡欙紩闂侀€炲苯澧剧紒鐘虫尭閻ｉ攱绺界粙璇俱劍銇勯弮鍥撴繛鍛墦濮婄粯鎷呮笟顖滃姼闂佹椿鍓欓妶绋跨暦閹存績妲堥柕蹇娾偓鍏呯棯闂備胶绮崝锕傚礈濞戞氨涓嶅Δ锝呭暞閻撴瑩鎮楀☉娆樼劷闁瑰啿鍟撮弻锝堢疀婵犲啯鐝氶梺鍝勭焿缂嶄線鐛Ο缁樼秶闁硅鍔忛崑鎾诲锤濡や胶鍘搁悗鍏夊亾闁逞屽墴瀹曚即骞囬澶屽姺闂婎偄娲﹂弻锝夊磻閸涘瓨鐓曢柟鑸妽濞呮捇鏌嶈閸撴瑧绮旈悷閭︽綎闁惧繐婀遍惌娆愮箾閸℃ê鍔ら柛鎾讳憾濮婃椽宕ㄦ繝鍐ｆ嫻闂佽崵鍟块弲娑㈩敋閿濆鍙婇煫鍥风稻閳诲绱撻崒娆掑厡濠殿喚鏁婚幆鍕敍閻愬弶鐎梺鍦濠㈡ê顔忓┑鍥ヤ簻闁圭儤鍨甸埀顒€缍婂鏌ユ偂鎼存ɑ鏂€闂佺粯锚閻忔岸寮抽埡鍛厱閻庯綆鍋嗗ú鎾煙椤斻劌娲ょ粈瀣亜閺嶃劍鐨戦柨娑欑懃閳规垿鎮╃紒妯婚敪濡炪倖鍨甸幊鎰垝婵犳艾鍐€闁靛鍊楃粻姘舵⒑闂堟稓澧曢柟鍐查叄瀵娊鎮欓悜妯煎幈闂佺粯锚瀵爼藟閵忋倖鐓涢悘鐐插⒔濞插鈧鍠楅幐铏繆閹间礁唯闁靛鍠楁禍銈夋⒒閸屾瑧鍔嶆俊鐐叉健瀹曪絾鎯旈妸銉х崶濠殿喗顭堟ご鎼侊綖閺囥垺鐓欓柟顖嗗懏鎲兼繝娈垮灡閹告娊寮婚敃鈧灒濞撴凹鍨辨闂備礁鎲￠敃鈺呭磻婵犲洤绠栨俊銈呮噹缁€鍌氼熆鐠虹尨姊楀瑙勬礈缁辨捇宕掑▎鎴М濡炪倖鍨靛Λ婵嬨€侀弽褉鏋庨柟鎯у暱閹偤姊洪崫鍕偍闁搞劍妞藉畷鎴︽晲婢跺鍘遍梺闈涱檧缁茶姤淇婇崸妤佺厪闁割偅绻勯幗鐘睬庨崶褝韬鐐存崌楠炴帡寮惔鎾冲緧闂傚倷绀侀幖顐﹀嫉椤掆偓鐓ゆ繝闈涚墢娑撳秵绻涢幋娆忕仼闁告濞婇弻锝夊箛椤撶偛顫囬梺绋挎捣閺佽顕ｆ繝姘櫜濠㈣泛谩瑜旈弻娑氫沪閸撗呭彎婵犮垼顫夊ú鏍煘閹达附鍋愭繛鍫熷濞堟壆绱撴担浠嬪摵婵炶尙鍠庨悾鐑藉箣閿曗偓缁狅綁鏌ㄩ弴妤€浜剧紒鐐劤缂嶅﹪寮婚垾宕囨殼妞ゆ棁澹堢€氫即鏌￠崨顖毿ｇ紒缁樼箞閹粙妫冨ù璁圭秮閺屻倝鎮烽弶搴撴寖婵犮垼顫夊ú妯兼崲濠靛棭娼╂い鎾跺Т楠炲秹姊绘担绛嬪殐闁搞劌閰ｅ畷姗€鎮欓渚囧晥缂傚倸鍊烽懗鍫曞磻閹捐纾块柟鎯版鍥撮梺褰掓？缁€渚€鎷戦悢鍏肩叆婵犻潧妫欓崳鎶芥煛鐎ｎ亪鍙勯柡宀€鍠栭弻鍥晝閳ь剟寮搁悢鍏肩厱闁挎稑宕ú锕傚煕閹寸姷妫い鎾跺仦閸ｆ椽鏌ｅ┑鎰偗闁哄本鐩顕€鍩€椤掑嫨鈧啴宕卞▎鎴濆触闂佺粯姊婚崢褔宕￠幎鑺ョ厪闊洤艌閸嬫捇宕楅崨顔间簼闂傚倷娴囬褏鎹㈤幒妤€纾婚柣鏂跨毞閳ь剨绠撳畷濂告偄娓氼垱閿ら梻浣虹帛閸旓箓宕滈敃鈧埢鎾寸鐎ｎ偆鍘介梺褰掑亰閸ㄤ即鎯冮崫鍔藉綊鎮╅鑲╀紙闂佸搫鏈惄顖氼嚕椤曗偓閸┾偓妞ゆ巻鍋撻柣锝嗙箞楠炴牗鎷呭灞炬啺闂備胶绮濠氬储瑜忕划鍫ュ礃椤旂晫鍘剧紒鐐緲瀹曨剚鏅堕悧鍫涗簻闁哄啠鍋撻悽顖ょ節瀵鏁冮埀顒冪亽闂佺粯鎸哥€涒晠鎮橀崼銉︹拺闁告繂瀚﹢鐗堢箾閸欏绠樼紒顔款嚙閳藉顫濋敐鍛闂佹寧绻傜花鑲╄姳閹绢喗鐓曢悗锝庡亝瀹曞瞼鈧鍠曠划娆撱€佸鈧幃銏ゆ憥閸屾粍娈?
    let upload_speed_mbps = if !upload_speeds.is_empty() {
        upload_speeds.iter().sum::<f64>() / upload_speeds.len() as f64
    } else {
        0.0
    };

    let download_speed_mbps = if !download_speeds.is_empty() {
        download_speeds.iter().sum::<f64>() / download_speeds.len() as f64
    } else {
        0.0
    };

    Ok(SpeedTestResult {
        upload_speed_mbps,
        download_speed_mbps,
    })
}

// Helper function to recursively list all entries because the server does not support Depth: infinity.
async fn recursive_list_webdav(
    http: &Client,
    endpoint: &WebDavEndpoint,
    path: &str,
) -> Result<Vec<crate::types::DavEntry>, String> {
    let mut all_entries = Vec::new();
    let mut dirs_to_visit = vec![path.to_string()];
    let mut visited_dirs = std::collections::HashSet::new();

    while let Some(dir_path) = dirs_to_visit.pop() {
        if !visited_dirs.insert(dir_path.clone()) {
            continue;
        }

        let list_path = if dir_path.is_empty() {
            None
        } else {
            Some(dir_path.as_str())
        };

        info!("WebDAV backup: Listing contents of '/'{}", &dir_path);
        let entries = match webdav::list_entries(http, endpoint, list_path, true).await {
            Ok(entries) => entries,
            Err(e) => {
                info!(
                    "WebDAV backup: Failed to list directory '{}': {}",
                    &dir_path, e
                );
                continue;
            }
        };

        for entry in entries {
            if entry.remote_path == dir_path {
                continue;
            }

            if entry.is_collection {
                // The list_entries logic ensures remote_path is clean and relative to root.
                // We just need to make sure we don't infinitely recurse if the server returns "."
                if entry.remote_path != dir_path {
                    dirs_to_visit.push(entry.remote_path.clone());
                }
            }
            all_entries.push(entry);
        }
    }
    Ok(all_entries)
}

async fn backup_webdav_to_path(
    state: &AppState,
    endpoint: &WebDavEndpoint,
    path: &Path,
    window: Option<&Window>,
) -> Result<(), String> {
    use futures_util::StreamExt;
    use std::io::Write;
    use zip::write::FileOptions;

    info!("--- Starting WebDAV Backup ---");
    emit_backup_restore_progress_if_needed(
        window,
        "webdav-backup-progress",
        "",
        0,
        0,
        "scanning",
    );

    // 1. Scanning
    let entries = recursive_list_webdav(&state.http, endpoint, "").await?;
    let total_entries = entries.len() as u64;

    if total_entries == 0 {
        emit_backup_restore_progress_if_needed(
            window,
            "webdav-backup-progress",
            "",
            0,
            0,
            "finished",
        );
        return Ok(());
    }

    // 2. Preparing Zip
    let file = std::fs::File::create(path).map_err(|e| format!("operation failed: {e}"))?;
    let mut zip = zip::ZipWriter::new(file);
    let options: FileOptions<'_, ()> =
        FileOptions::default().compression_method(zip::CompressionMethod::Deflated);

    // 3. Process Entries
    let temp_dir = state
        .workspace_root
        .join("runtime")
        .join(format!("temp_backup_{}", now_ms()));
    fs::create_dir_all(&temp_dir).map_err(|e| format!("operation failed: {e}"))?;

    for (index, entry) in entries.iter().enumerate() {
        let current_progress = (index + 1) as u64;
        emit_backup_restore_progress_if_needed(
            window,
            "webdav-backup-progress",
            &entry.filename,
            current_progress,
            total_entries,
            "downloading",
        );

        if entry.is_collection {
            if !entry.remote_path.is_empty() {
                if let Err(e) = zip.add_directory(&entry.remote_path, options) {
                    log::warn!("Failed to add directory '{}': {}", &entry.remote_path, e);
                }
            }
            continue;
        }

        let remote_path = &entry.remote_path;
        if remote_path.is_empty() {
            continue;
        }

        // Stream download to temp file
        let temp_file_path = temp_dir.join(format!("backup_{}.tmp", index));

        let download_result = webdav::download_file_stream(&state.http, endpoint, remote_path).await;
        match download_result {
            Ok(response) => {
                let mut stream = response.stream;
                // Use std::fs::File (Blocking write) as tokio::fs is not enabled
                let mut temp_file = std::fs::File::create(&temp_file_path)
                    .map_err(|e| format!("operation failed: {e}"))?;
                while let Some(chunk) = stream.next().await {
                    let chunk = chunk.map_err(|e| format!("operation failed: {e}"))?;
                    temp_file
                        .write_all(&chunk)
                        .map_err(|e| format!("operation failed: {e}"))?;
                }
                temp_file
                    .flush()
                    .map_err(|e| format!("operation failed: {e}"))?;
                drop(temp_file);

                // Write to Zip (Sync)
                let mut input_file = std::fs::File::open(&temp_file_path)
                    .map_err(|e| format!("operation failed: {e}"))?;
                if let Err(e) = zip.start_file(remote_path, options) {
                    let _ = std::fs::remove_file(&temp_file_path);
                    return Err(format!("Zip start_file failed: {}", e));
                }
                if let Err(e) = std::io::copy(&mut input_file, &mut zip) {
                    let _ = std::fs::remove_file(&temp_file_path);
                    return Err("operation failed".to_string());
                }
                let _ = std::fs::remove_file(&temp_file_path);
            }
            Err(e) => {
                log::warn!(
                    "Skipping file '{}' due to download error: {}",
                    remote_path,
                    e
                );
            }
        }
    }

    zip.finish()
        .map_err(|e| format!("operation failed: {e}"))?;
    let _ = std::fs::remove_dir_all(&temp_dir);
    record_local_backup_event(
        state,
        endpoint,
        path.to_string_lossy().as_ref(),
        "backup-webdav",
    )?;

    emit_backup_restore_progress_if_needed(
        window,
        "webdav-backup-progress",
        "",
        total_entries,
        total_entries,
        "finished",
    );
    Ok(())
}

#[tauri::command]
async fn backup_webdav(
    window: Window,
    state: State<'_, AppState>,
    path: String,
) -> Result<(), String> {
    let settings = current_settings(&state)?;
    let endpoint = resolve_active_endpoint(&settings)?;
    backup_webdav_to_path(&state, &endpoint, Path::new(&path), Some(&window)).await
}

#[tauri::command]
async fn restore_webdav(
    window: Window,
    state: State<'_, AppState>,
    path: String,
) -> Result<(), String> {
    use std::io::Read;
    use zip::ZipArchive;

    use bytes::Bytes;

    let settings = current_settings(&state)?;
    let endpoint = resolve_active_endpoint(&settings)?;

    emit_backup_restore_progress(&window, "webdav-restore-progress", "", 0, 0, "scanning");

