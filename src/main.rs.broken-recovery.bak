fn normalize_download_dir(raw: &str, fallback: &Path) -> String {
    let trimmed = raw.trim();
    if trimmed.is_empty() {
        fallback.to_string_lossy().to_string()
    } else {
        trimmed.to_string()
    }
}

fn endpoint_files_dir(state: &AppState, endpoint_id: &str) -> PathBuf {
    state.files_base_dir.join(endpoint_id)
}

fn history_cache_dir(state: &AppState, endpoint_id: &str) -> PathBuf {
    let workspace_dir = endpoint_files_dir(state, endpoint_id).join("history-cache");
    if workspace_dir.exists() {
        return workspace_dir;
    }
    let legacy_dir = state
        .settings_path
        .parent()
        .unwrap_or_else(|| Path::new("."))
        .join("files")
        .join(endpoint_id)
        .join("history-cache");
    if legacy_dir.exists() {
        return legacy_dir;
    }
    workspace_dir
}

fn history_mirror_dir(state: &AppState, endpoint_id: &str) -> PathBuf {
    endpoint_files_dir(state, endpoint_id)
        .join("mirrors")
        .join("history")
}

fn sync_local_history_mirror(
    state: &AppState,
    endpoint: &WebDavEndpoint,
    history: &[HistoryEntry],
    tags: &[MarkedTag],
) -> Result<(), String> {
    let mirror_dir = history_mirror_dir(state, &endpoint.id);
    fs::create_dir_all(&mirror_dir)
        .map_err(|err| format!("operation failed: {err}"))?;

    let index = LocalHistoryMirrorIndex {
        endpoint_id: &endpoint.id,
        updated_at_ms: now_ms(),
        entry_count: history.len(),
        tag_count: tags.len(),
    };
    workspace::write_json_with_audit_at(
        &mirror_dir.join("index.json"),
        &index,
        Some(&state.workspace_root),
        "history-mirror",
        "write-index",
    )?;
    workspace::write_json_with_audit_at(
        &mirror_dir.join("entries.json"),
        &history,
        Some(&state.workspace_root),
        "history-mirror",
        "write-entries",
    )?;
    workspace::write_json_with_audit_at(
        &mirror_dir.join("tags.json"),
        &tags,
        Some(&state.workspace_root),
        "history-mirror",
        "write-tags",
    )?;
    Ok(())
}

async fn persist_history_state(
    state: &AppState,
    endpoint: &WebDavEndpoint,
    history: &[HistoryEntry],
    tags: &[MarkedTag],
) -> Result<(), String> {
    crate::history::save_history(&state.http, endpoint, history, tags).await?;
    sync_local_history_mirror(state, endpoint, history, tags)
}

fn record_local_backup_event(
    state: &AppState,
    endpoint: &WebDavEndpoint,
    backup_path: &str,
    source: &str,
) -> Result<(), String> {
    let filename = format!("{}-{}.json", endpoint.id, now_ms());
    let target = state.workspace_root.join("backups").join(filename);
    let record = LocalBackupRecord {
        endpoint_id: &endpoint.id,
        backup_path,
        created_at_ms: now_ms(),
        source,
    };
    workspace::write_json_with_audit_at(
        &target,
        &record,
        Some(&state.workspace_root),
        "backup-record",
        source,
    )
}

fn auto_backup_state_path(state: &AppState) -> PathBuf {
    state.workspace_root.join("backups").join("auto-backup-state.json")
}

fn auto_backup_archives_dir(state: &AppState, endpoint_id: &str) -> PathBuf {
    state
        .workspace_root
        .join("backups")
        .join("archives")
        .join(endpoint_id)
}

fn load_auto_backup_state(state: &AppState) -> AutoBackupStateRecord {
    let path = auto_backup_state_path(state);
    if !path.is_file() {
        return AutoBackupStateRecord::default();
    }
    fs::read_to_string(&path)
        .ok()
        .and_then(|content| serde_json::from_str::<AutoBackupStateRecord>(&content).ok())
        .unwrap_or_default()
}

fn save_auto_backup_state(state: &AppState, record: &AutoBackupStateRecord) -> Result<(), String> {
    workspace::write_json_with_audit_at(
        &auto_backup_state_path(state),
        record,
        Some(&state.workspace_root),
        "backup-schedule",
        "save-state",
    )
}

fn prune_auto_backup_archives(dir: &Path, retain_count: u32) -> Result<(), String> {
    if !dir.is_dir() {
        return Ok(());
    }
    let mut entries = fs::read_dir(dir)
        .map_err(|err| format!("闂傚倸鍊搁崐鎼佸磹閹间礁纾归柟闂寸绾惧綊鏌熼梻瀵割槮缁炬儳缍婇弻鐔兼⒒鐎靛壊妲紒鐐劤濠€閬嶅焵椤掑倹鍤€閻庢凹鍙冨畷宕囧鐎ｃ劋姹楅梺鍦劋閸ㄥ綊宕愰悙鐑樺仭婵犲﹤鍟扮粻鑽も偓娈垮枟婵炲﹪寮崘顔肩＜婵炴垶鑹鹃獮鍫熶繆閻愵亜鈧倝宕㈡禒瀣瀭闁割煈鍋嗛々鍙夌節闂堟侗鍎愰柣鎾存礃缁绘盯宕卞Δ鍐唺缂備胶濮撮…鐑藉蓟閿涘嫪娌紒瀣仢閳峰鎮楅崹顐ｇ凡閻庢凹鍣ｉ崺鈧い鎺戯功缁夐潧霉濠婂嫮绠炴い銏＄懇瀹曘劑顢樺☉娆愭澑闂備胶绮崝鏇烆嚕閸洖鐓濋柡鍥╀紳閻熼偊鐓ラ柛鏇ㄥ幘閻撳姊虹拠鈥虫灀闁逞屽墯閺嬬厧危閸儲鐓忛煫鍥ュ劤绾惧潡鏌涘Ο鍝勮埞闁宠鍨块幃鈺呭箥瀹ュ懐澧︾€规洘鍨块獮妯肩磼濡厧骞楅梻浣侯攰濞咃綁宕戦悢鍏煎仼闁汇垻顣介崑鎾斥枔閸喗鐏嶉梺缁樻惈缁绘繈濡存笟鈧顕€宕煎┑瀣暪闂備胶绮Λ浣搞€掕ぐ鎺撳仺缂備焦顭囩弧鈧梺姹囧灲濞佳冪摥闂備焦瀵уú蹇涘磹濡ゅ懎鐒垫い鎺嶇閸ゎ剟鏌涢幘璺烘灈妤犵偛鍟～婊堝焵椤掆偓椤曪綁宕奸弴鐐殿吅闂佸搫鍟犻崑鎾绘煛閸屾浜鹃梻鍌氬€烽悞锔锯偓绗涘懐鐭欓柟瀵稿Л閸嬫挸顫濋悡搴＄睄閻庢鍠楁繛濠囥€佸Δ浣虹懝闁搞儺鐓堥崯宥夋⒒娴ｈ櫣甯涢柛鏃€娲栭锝夊醇閺囩偟鐛ュ┑鈽嗗灠閻ㄧ兘宕戦幘鏂ユ灁闁割煈鍠楅悘鍫熺節閳封偓閸愵喖寮板Δ鐘靛仦閸ㄥ灝鐣烽悢纰辨晬婵絽鐨烽弲鐘诲蓟閺囩喎绶為柛顐ｇ箘娴犲吋绻涚€涙鐭掔紒鐘崇墵瀵鏁愭径濠勭杸濡炪倖甯婄拋鏌ュ几濞嗗繆鏀介柣鎰摠鐏忣厽銇勯鐘插幋鐎殿喖顭峰鎾閻樿鏁规繝鐢靛█濞佳兠归崒姣兼盯鎮欓悽鐢碉紳婵炶揪缍€椤曟牕鈻撻弮鍫熺厱濠电姴鎳庨崥瑙勪繆閸欏濮嶆鐐村笒铻栭柍褜鍓熼幃鐐哄垂椤愮姳绨婚梺鐟版惈缁夊爼宕濆鍛斀妞ゆ牗鍑归崵鐔虹磼鏉堛劌娴い銏＄☉閳藉鈻庨幋顓熜為梻鍌欐祰椤曆呮崲鐎ｎ剛鐭嗗〒姘ｅ亾闁糕晝鍋ら獮瀣晜閽樺姹楅梺鑽ゅТ濞壯囧礃瑜忛惌妤呮⒒閸屾瑧顦﹂柟鑺ョ矋閹便劑鎮介崨濠傛疄婵°倧绲介崯顐ョ箽闂備礁婀遍崕銈夊箰閸撗冨К闁逞屽墮閳规垿顢欓弬銈勭返闂佸憡锕㈢粻鏍х暦閵忋値鏁傞柛顐ゅ暱閹锋椽姊洪崨濠冨鞍鐟滄澘鍟粋宥呪攽閸垻锛滈柣鐘叉处瑜板啴寮抽敐鍥ｅ亾鐟欏嫭绀冨┑鐐诧躬楠炲啴骞嗚閺嗗棝鏌嶈閸撴稒绔熼弴鐔洪檮闁告稑锕﹂崢钘夆攽閳藉棗鐏犻柟纰卞亰閹虫粓宕烽娑樹壕閻熸瑥瀚亸顓熶繆椤愶絿绠炵€殿喖顭烽幃銏㈠枈鏉堛劍娅撶紓鍌欑劍缁嬫垿顢栭崱娑欏仼閻犺桨璀﹀〒濠氭煏閸繈顎楀ù婊勭箘缁辨帞鎷犻懠顒€鈪靛Δ鐘靛仜閸熸挳宕洪崟顖氱闁宠桨绀佹俊鎶芥⒒娴ｇ懓鈻曢柡渚囧櫍瀹曟垿骞樼紒妯煎幍闂佸搫顑愰崑鍕焵椤掍胶澧紒宀冮哺缁绘繈宕堕妸銉㈠亾闁垮浜滈煫鍥ㄦ尭椤忋倝鏌涚€ｎ偅宕屾鐐差儔閺佸啴鍩€椤掑倸顥氱憸鐗堝笚閻撴盯鏌涢妷銏℃珔鐞氥儵姊虹粙娆惧剱闁瑰憡鎮傞敐鐐测攽鐎ｎ偄浜楅柟鑲╄ˉ濡狙囧箯椤愶附鈷掑ù锝堟閵嗗﹪鏌￠崨顔剧疄鐎规洘鍨挎俊鑸靛緞鐏炵晫銈﹂梺璇插嚱缂嶅棝宕板Δ鍛柧婵犲﹤鐗婇悡銏′繆椤栨瑨顒熸俊鏌ユ敱閹便劎鎲撮崟鍨暦婵烇絽娲ら敃顏堝箖濞嗘搩鏁傞柛鏇樺妼娴滈箖鏌″搴ｄ粶婵炴垶鐟ч悷褰掓煃瑜滈崜娆撴偩閻戣棄绠ｉ柨鏇楀亾缂佺姵绋掗妵鍕箻鐠哄搫澹夐梺鎼炲€戦崐婵嗩潖濞差亜绠归柣鎰絻婵⊙囨⒑闁偛鑻晶瀵糕偓娈垮枔閸斿秶绮嬮幒鏂哄亾閿濆骸浜為柛妯圭矙濮婇缚銇愰幒鎴滃枈闂佸憡鎸诲畝鎼佸春閵忋倕鍗抽柣鏂垮缁犳岸姊洪崷顓犲笡閻㈩垱顨堥幏褰掓晬閸曨厾锛滈柡澶婄墑閸斿瞼绮閺屽秷顧侀柛鎾卞妿缁辩偤宕卞☉妯硷紱闂佸憡娲﹂崹閬嶅磹閸洘鐓冮柛婵嗗閸ｆ椽鏌ｉ幘瀛樼缂佺粯鐩畷鍗炍旈崘顏嶅敼闂備焦鎮堕崐鏇灻洪敃鍌氱疄闁靛濡囩弧鈧梺鍛婂姀閺傚倹绂掗姀鐘栨棃鎮╅棃娑楁勃闂佸憡姊归悧鐘荤嵁閸℃稑绫嶉柛顐ゅ枑濞呮粓姊洪幖鐐插姉闁哄懏绮岄埢鎾绘偂鎼存ɑ鏂€闂佹寧绋戠€氼剚绂嶆總鍛婄厱濠电倯鍐╁櫝闁稿鎹囧Λ鍐ㄢ槈濮樺崬濮遍柣搴ゎ潐濞叉牜绱炴繝鍌滄殾濠靛倻顭堥崡鎶芥煟閹邦喗鏆╅柡瀣暞缁绘繈鎮介棃娴躲垽鏌ㄩ弴妯衡偓鏇＄亱闁瑰吋鐣崹濠氥€呴懠顒佸枑闁绘鐗嗙粭姘舵煟閹惧鎳囬柡宀嬬秮楠炲鎮欓崱妯虹仼濞存粍鎮傞幃浠嬪川婵犲嫬骞堟繝娈垮枟椤ㄥ懎螞閺冨牊鐒芥い鏍ㄧ⊕閸欏繐鈹戦悩鎻掓殲闁靛洦绻勯埀顒冾潐濞叉鍒掗幘鑽ゅ祦闁规崘顕х粻宕団偓骞垮劚濞层倝宕甸鍌滅＝闁稿本鑹鹃埀顒€鍢查湁闁搞儺鍓﹂弫瀣喐韫囨洖鍨濋柡鍐ㄧ墕缁狙囨煙鐎涙绠橀柕鍫亰濮婃椽鎳￠妶鍛€剧紓渚囧枛鐎涒晠寮茬捄浣曟棃宕橀埡鍌涱唶婵犲痉鏉库偓鏇㈠箠韫囨稑纾婚柛宀€鍋為悡娑㈡煕閵夛絽鍔氶柣蹇婃櫇缁辨帡鎮╅崣澶庣缂備浇椴哥敮锟犮€佸▎鎾村亗閹肩话銈囩闂傚倷鑳堕…鍫ヮ敄閸℃稑绠查柛銉墰瀹撲線鏌涢妷锝呭濠殿垰顕槐鎺斺偓锝庡弾閸わ箓鏌曟繛鐐珕闁抽攱甯￠弻娑氫沪閸撗勫櫘缂備焦鍔栧鍦崲濞戞瑦濯撮柛鎰絻楠炴ɑ