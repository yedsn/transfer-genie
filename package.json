{
    "name": "transfer-genie",
    "version": "0.5.7",
    "private": true,
    "type": "module",
    "description": "A WebDAV-based cross-device file transfer and text sync desktop app with HTTP API and Telegram Bridge.",
    "homepage": "https://yedsn.github.io/transfer-genie/",
    "repository": {
        "type": "git",
        "url": "https://github.com/yedsn/transfer-genie.git"
    },
    "keywords": [
        "webdav",
        "file-transfer",
        "text-sync",
        "desktop-app",
        "tauri",
        "rust",
        "self-hosted",
        "telegram-bot",
        "http-api",
        "windows",
        "macos"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "typecheck": "vue-tsc --noEmit",
        "tauri": "tauri",
        "tauri:dev": "tauri dev",
        "tauri:build": "tauri build",
        "ios:update": "bash scripts/ios-wireless-update.sh",
        "ios:update:launch": "bash scripts/ios-wireless-update.sh --launch",
        "ios:simulator:deploy": "node scripts/ios-virtual-deploy.mjs simulator deploy",
        "ios:simulator:dev": "node scripts/ios-virtual-deploy.mjs simulator dev",
        "ios:vphone:deploy": "node scripts/ios-virtual-deploy.mjs vphone deploy",
        "ios:vphone:dev": "node scripts/ios-virtual-deploy.mjs vphone deploy --debug",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "docs:verify-seo": "DOCS_BASE=/transfer-genie/ vitepress build docs && node scripts/verify_docs_seo.mjs",
        "docs:verify-live-seo": "node scripts/verify_docs_live_seo.mjs",
        "test:vphone": "node tests/vphone/test_vphone_smoke.mjs"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "@milkdown/kit": "7.23.0",
        "dompurify": "^3.4.17",
        "marked": "^15.0.12",
        "transfer-genie": "file:",
        "vue": "^3.5.13"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.8.4",
        "@vitejs/plugin-vue": "^5.2.1",
        "typescript": "^5.7.2",
        "vite": "^6.0.3",
        "vitepress": "^1.6.4",
        "vue-tsc": "^2.1.10"
    }
}
