# Local iOS wireless update configuration
#
# Copy this file to .env before running `npm run ios:update`.
# The .env file is ignored by Git and must contain the settings for the Mac
# and iPhone used by each developer. Do not commit personal device details.
#
# Find the paired device name or UDID with:
#   xcrun devicectl list devices
TRANSFER_GENIE_IOS_DEVICE=YOUR_DEVICE_NAME_OR_UDID

# Find the Apple Development Team ID in Xcode:
#   Xcode > Settings > Accounts > Team Details
APPLE_DEVELOPMENT_TEAM=YOUR_APPLE_TEAM_ID

# Optional: use a different Cargo home for iOS dependencies. Relative paths
# are resolved from the project root because the update runs there.
# TRANSFER_GENIE_IOS_CARGO_HOME=.cargo-ios

# Optional: token used by the Gitee release helper.
GITEE_ACCESS_TOKEN=your_gitee_access_token_here
