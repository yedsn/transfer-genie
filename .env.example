# Local iOS device, Simulator and VPhone configuration
#
# Copy this file to .env before running the iOS update/deploy/dev commands.
# The .env file is ignored by Git and must contain the settings for the Mac
# and iPhone used by each developer. Do not commit personal device details.
#
# Find the paired device name or UDID with:
#   xcrun devicectl list devices
TRANSFER_GENIE_IOS_DEVICE=YOUR_DEVICE_NAME_OR_UDID

# Find the Apple Development Team ID in Xcode:
#   Xcode > Settings > Accounts > Team Details
APPLE_DEVELOPMENT_TEAM=YOUR_APPLE_TEAM_ID

# Share Extension is opt-in. Keep disabled until both bundle IDs have an
# Apple Developer App Group profile. Set to 1 to include and verify it.
# TRANSFER_GENIE_IOS_SHARE_EXTENSION=1

# Optional: use a different Cargo home for iOS dependencies. Relative paths
# are resolved from the project root because the update runs there.
# TRANSFER_GENIE_IOS_CARGO_HOME=.cargo-ios

# Optional: location of the latest signed iPhone build produced by the daily
# TaskTick job. Relative paths are resolved from the project root. The default
# lives under the ignored gen/apple/build directory.
# TRANSFER_GENIE_IOS_LATEST_BUILD_DIR=gen/apple/build/ios-wireless-latest

# Optional: unattended keepalive tuning for `npm run ios:keepalive`.
# Rebuild when the cached provisioning profile has less than this many hours
# left; alert when less than the alert threshold remains and today has no
# successful install; wait this long after a failed build before retrying.
# TRANSFER_GENIE_IOS_KEEPALIVE_REBUILD_HOURS=72
# TRANSFER_GENIE_IOS_KEEPALIVE_ALERT_HOURS=48
# TRANSFER_GENIE_IOS_KEEPALIVE_BUILD_COOLDOWN_HOURS=3

# Simulator: choose an available name or UDID from `xcrun simctl list devices`.
# If omitted, exactly one booted iPhone (or one available iPhone) is required.
# TRANSFER_GENIE_IOS_SIMULATOR=YOUR_SIMULATOR_NAME_OR_UDID

# Optional: preserve the signing/Keychain group of an existing Simulator app.
# Defaults to APPLE_DEVELOPMENT_TEAM; use the same team as the installed app.
# TRANSFER_GENIE_IOS_SIMULATOR_TEAM=YOUR_SIMULATOR_TEAM_ID

# VPhone: obtain the exact machine name and libraryRoot from:
#   /Applications/vphone-launchpad.app/Contents/MacOS/vphone-launchpad-cli vm list
# Both values are required for the VPhone launch entries; no disk is hard-coded.
# VPHONE_MACHINE=YOUR_VPHONE_MACHINE_NAME
# VPHONE_LIBRARY_ROOT=/Volumes/YOUR_EXTERNAL_VOLUME/machines
# Optional: override the default Launchpad CLI location.
# VPHONE_CLI=/Applications/vphone-launchpad.app/Contents/MacOS/vphone-launchpad-cli

# Optional: smoke reports. Defaults to the
# ignored gen/apple/build/vphone-smoke directory on the project volume.
# VPHONE_ARTIFACT_DIR=/Volumes/YOUR_EXTERNAL_VOLUME/ios-test-artifacts

# Optional: token used by the Gitee release helper.
GITEE_ACCESS_TOKEN=your_gitee_access_token_here
